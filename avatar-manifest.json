  "defaults": {
    "body": "light",
    "eyes": "pink",
    "expression": "neutral",
    "hairStyle": "long",
    "hairColor": "brown",
    "outfit": "sakura_casual",
    "accessory": "none"
  },
  "notes": {
    "expressionEyes": "Hide the eyes layer when the selected expression has suppressEyes=true.",
    "hairClip": "The supplied reference atlas already includes a small sakura flower in many hair-front sprites. Selecting sakura_clip may visually stack another flower."
  }
}