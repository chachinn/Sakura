{
  "schemaVersion": 1,
  "name": "Sakura Avatar Assets",
  "canvas": {
    "width": 512,
    "height": 768,
    "format": "PNG",
    "colorMode": "RGBA",
    "transparentBackground": true,
    "origin": [
      0,
      0
    ]
  },
  "rendering": {
    "allLayersShareCanvas": true,
    "css": {
      "position": "absolute",
      "inset": 0,
      "width": "100%",
      "height": "100%",
      "objectFit": "contain",
      "pointerEvents": "none"
    },
    "layerOrder": [
      {
        "id": "hairBack",
        "z": 10
      },
      {
        "id": "body",
        "z": 20
      },
      {
        "id": "expression",
        "z": 30
      },
      {
        "id": "eyes",
        "z": 31
      },
      {
        "id": "outfit",
        "z": 40
      },
      {
        "id": "hairFront",
        "z": 50
      },
      {
        "id": "accessory",
        "z": 60
      }
    ]
  },
  "body": [
    {
      "id": "light",
      "path": "body/light.png"
    },
    {
      "id": "light_medium",
      "path": "body/light_medium.png"
    },
    {
      "id": "medium",
      "path": "body/medium.png"
    },
    {
      "id": "medium_deep",
      "path": "body/medium_deep.png"
    },
    {
      "id": "deep",
      "path": "body/deep.png"
    }
  ],
  "eyes": [
    {
      "id": "pink",
      "path": "eyes/pink.png"
    },
    {
      "id": "brown",
      "path": "eyes/brown.png"
    },
    {
      "id": "hazel",
      "path": "eyes/hazel.png"
    },
    {
      "id": "blue",
      "path": "eyes/blue.png"
    },
    {
      "id": "green",
      "path": "eyes/green.png"
    },
    {
      "id": "purple",
      "path": "eyes/purple.png"
    },
    {
      "id": "aqua",
      "path": "eyes/aqua.png"
    }
  ],
  "expressions": [
    {
      "id": "neutral",
      "path": "expressions/neutral.png",
      "suppressEyes": false
    },
    {
      "id": "soft_smile",
      "path": "expressions/soft_smile.png",
      "suppressEyes": false
    },
    {
      "id": "happy",
      "path": "expressions/happy.png",
      "suppressEyes": true
    },
    {
      "id": "wink",
      "path": "expressions/wink.png",
      "suppressEyes": true
    },
    {
      "id": "laugh",
      "path": "expressions/laugh.png",
      "suppressEyes": true
    },
    {
      "id": "excited",
      "path": "expressions/excited.png",
      "suppressEyes": false
    },
    {
      "id": "sad",
      "path": "expressions/sad.png",
      "suppressEyes": false
    },
    {
      "id": "angry",
      "path": "expressions/angry.png",
      "suppressEyes": false
    },
    {
      "id": "surprised",
      "path": "expressions/surprised.png",
      "suppressEyes": false
    }
  ],
  "hair": {
    "styles": [
      "long",
      "twin_tails",
      "ponytail",
      "bob",
      "shoulder_length",
      "bun"
    ],
    "colors": [
      "brown",
      "black",
      "dark_brown",
      "blonde",
      "pink",
      "lavender",
      "blue",
      "white_silver"
    ],
    "backPattern": "hair-back/{style}/{color}.png",
    "frontPattern": "hair-front/{style}/{color}.png"
  },
  "outfits": [
    {
      "id": "sakura_casual",
      "path": "outfits/sakura_casual.png"
    },
    {
      "id": "academic",
      "path": "outfits/academic.png"
    },
    {
      "id": "travel",
      "path": "outfits/travel.png"
    },
    {
      "id": "cafe",
      "path": "outfits/cafe.png"
    },
    {
      "id": "yukata",
      "path": "outfits/yukata.png"
    }
  ],
  "accessories": [
    {
      "id": "none",
      "path": null
    },
    {
      "id": "sakura_clip",
      "path": "accessories/sakura_clip.png"
    },
    {
      "id": "ribbon",
      "path": "accessories/ribbon.png"
    },
    {
      "id": "beret",
      "path": "accessories/beret.png"
