    "reading": "は",
    "romaji": "wa",
    "categories": [
      "Topic",
      "Contrast"
    ],
    "frequencyTier": "Essential",
    "coreMeaning": "as for… / speaking of…",
    "usedFor": "topic and contrast",
    "explanation": "は tells the listener what the sentence is about and can contrast one topic with another.",
    "patterns": [
      {
        "form": "N は …",
        "meaning": "As for N…"
      }
    ],
    "examples": [
      {
        "japanese": "私は学生です。",
        "kana": "わたしは がくせいです。",
        "romaji": "watashi wa gakusei desu.",
        "english": "I am a student."
      }
    ],
    "contrasts": [
      {
        "particle": "が",
        "explanation": "が identifies/highlights the subject; は frames the topic."
      }
    ],
    "notes": "",
    "learnerCaution": "Particle は is pronounced wa."
  },
